<mxfile host="app.diagrams.net" agent="Claude" version="24.0.0">
  <diagram id="nova-solidstep-vuln" name="SOLIDSTEP 취약점 관리 프로세스">
    <mxGraphModel dx="1000" dy="720" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="880" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===== TITLE ===== -->
        <mxCell id="title" value="SOLIDSTEP 진단 후 취약점 관리 프로세스" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Georgia;fontSize=16;fontStyle=1;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="30" y="14" width="900" height="26" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="보안 진단 → (양호/취약) → 현업·보안팀 검토 → 조치불가(예외처리) / 취약관리(단·중·장기) 분류·결재 상신 → 방화벽 오픈 전 특칙 적용" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=10;fontColor=#7D7D7D;" vertex="1" parent="1">
          <mxGeometry x="31" y="42" width="1130" height="16" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="상태 분류: ① 양호   ② 취약   ③ 조치불가   ④ 취약관리(단기/중기/장기)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=10;fontStyle=1;fontColor=#D04A02;" vertex="1" parent="1">
          <mxGeometry x="31" y="60" width="1130" height="16" as="geometry" />
        </mxCell>

        <!-- ===== TOP FLOW ===== -->
