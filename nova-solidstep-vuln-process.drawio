          <mxGeometry x="490" y="88" width="220" height="40" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="&lt;b&gt;진단&lt;br&gt;결과?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#D04A02;strokeColor=#D04A02;fontFamily=Arial;fontSize=10;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1">
