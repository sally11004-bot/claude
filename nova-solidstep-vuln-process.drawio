          <mxGeometry x="545" y="294" width="110" height="62" as="geometry" />
        </mxCell>

        <!-- ===== 조치불가 (LEFT) ===== -->
        <mxCell id="imp" value="&lt;b&gt;조치불가 (예외처리)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;&#8226; 기술적/운영상 원천 조치 불가 확인&lt;br&gt;&#8226; 결재: &#39;운영상 조치 불가 항목&#39;&lt;br&gt;&#8226; 증적: 조치 불가능 사유 필요&lt;br&gt;&#8226; 사유 해소 시 상태 변경 가능&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E0301E;strokeWidth=2;fontFamily=Arial;fontSize=10;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="392" width="270" height="150" as="geometry" />
        </mxCell>
        <mxCell id="impres" value="&lt;b&gt;예외 승인 · 등록&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;결재 상신 → 승인 후 예외 등록 · 주기 재평가&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DB536A;strokeWidth=1.5;fontFamily=Arial;fontSize=10;fontColor=#000000;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="602" width="270" height="52" as="geometry" />
        </mxCell>

        <!-- ===== 취약관리 (RIGHT) ===== -->
        <mxCell id="vhub" value="&lt;b&gt;취약관리 (기한 내 조치 예정)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;즉각 조치 곤란 → 단·중·장기 분류&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D04A02;strokeWidth=2;fontFamily=Arial;fontSize=10;fontColor=#000000;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="680" y="384" width="250" height="40" as="geometry" />
        </mxCell>

        <mxCell id="sh" value="&lt;b&gt;단기&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;&#8226; 조치 일정: 6개월 이내&lt;br&gt;&#8226; 결재: 취약관리 단기 상신&lt;br&gt;&#8226; 증적: 조치 기간 필요 사유&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D04A02;strokeWidth=2;fontFamily=Arial;fontSize=10;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="440" y="452" width="235" height="130" as="geometry" />
        </mxCell>
        <mxCell id="mid" value="&lt;b&gt;중기&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;&#8226; 조치 일정: 1년 이내&lt;br&gt;&#8226; 결재: 취약관리 중기 상신&lt;br&gt;&#8226; 증적: EOS 대개체 계획&lt;br&gt;&nbsp;&nbsp;or 조치 계획 필요&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EB8C00;strokeWidth=2;fontFamily=Arial;fontSize=10;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="685" y="452" width="235" height="130" as="geometry" />
        </mxCell>
        <mxCell id="lng" value="&lt;b&gt;장기&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;&#8226; 조치 일정: 1~3년 이내&lt;br&gt;&#8226; 결재: 취약관리 장기 상신&lt;br&gt;&#8226; 증적: EOS 대개체 계획&lt;br&gt;&nbsp;&nbsp;or 조치 계획 필요&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFB600;strokeWidth=2;fontFamily=Arial;fontSize=10;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="930" y="452" width="235" height="130" as="geometry" />
        </mxCell>

        <mxCell id="vmres" value="&lt;b&gt;결재 상신 · 승인 → 기한 내 조치&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;승인 후 일정 내 조치 수행 → 조치 완료&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#464646;strokeWidth=1.5;fontFamily=Arial;fontSize=10;fontColor=#000000;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="600" y="602" width="400" height="52" as="geometry" />
