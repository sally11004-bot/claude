        <mxCell id="good" value="&lt;b&gt;양호&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;조치 불요 · 결과 기록/관리&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7D7D7D;fontFamily=Arial;fontSize=10;fontColor=#000000;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="740" y="150" width="230" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="&lt;b&gt;현업 · 보안팀 검토&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;취약 항목 검토 후 상태 분류&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EAEAEA;fontFamily=Arial;fontSize=10;fontColor=#000000;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="490" y="232" width="220" height="42" as="geometry" />
        </mxCell>
