        <!-- ===== FIREWALL SPECIAL RULE ===== -->
        <mxCell id="fwbox" value="방화벽 오픈 전 프로세스 (특칙)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#D04A02;strokeWidth=2;verticalAlign=top;align=left;fontFamily=Arial;fontSize=11;fontStyle=1;fontColor=#D04A02;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="694" width="1105" height="130" as="geometry" />
        </mxCell>
        <mxCell id="fw1" value="&lt;b&gt;①&lt;/b&gt; &#39;상(High)&#39; 취약점 미존재 시: &lt;b&gt;조치 일정만큼 버퍼&lt;/b&gt; 부여 후 기간 만료 시 &lt;b&gt;재진단&lt;/b&gt; 진행 (최대 1년 단위 승인 · 취약관리 &lt;b&gt;장기&lt;/b&gt;는 매년 재평가/재진단 필수)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=10;fontColor=#2D2D2D;" vertex="1" parent="1">
          <mxGeometry x="80" y="728" width="1065" height="40" as="geometry" />
        </mxCell>
        <mxCell id="fw2" value="&lt;b&gt;②&lt;/b&gt; 조치불가 항목: &#39;상&#39; 취약점 미존재 + 업무 필수성 등 &lt;b&gt;객관적 사유 확인&lt;/b&gt; + 보완 통제(EDR · WAF 등) 적용 &lt;b&gt;승인&lt;/b&gt; 시 &lt;b&gt;Open 수행&lt;/b&gt; (연 1회 재평가)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=10;fontColor=#2D2D2D;" vertex="1" parent="1">
