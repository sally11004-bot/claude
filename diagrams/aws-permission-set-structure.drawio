<mxfile host="app.diagrams.net"><diagram id="ps" name="AWS 권한세트 구조"><mxGraphModel dx="1600" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="800" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="AWS 권한세트는 ‘공통 인프라 6종 + 계정별 서비스 역할’의 2계층으로 분리해 최소권한과 계정 경계를 동시에 확보한다" style="html=1;whiteSpace=wrap;fontFamily=Arial;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Georgia;fontSize=22;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1520" height="40" as="geometry"/></mxCell><mxCell id="c3" value="차세대 BSS · AWS IAM Identity Center 권한세트(Permission Set) 구조 (안)" style="html=1;whiteSpace=wrap;fontFamily=Arial;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#7D7D7D;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="1520" height="24" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;기업 IdP / SSO&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#7D7D7D'&gt;사용자·그룹 원천 (SCIM 동기화) · MFA&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=0;fillColor=#FFFFFF;strokeColor=#7D7D7D;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="230" height="64" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;AWS IAM Identity Center&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#7D7D7D'&gt;Org 관리(위임) 계정 · 권한세트 중앙 정의/배포&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=0;fillColor=#FFFFFF;strokeColor=#D04A02;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="340" y="110" width="300" height="64" as="geometry"/></mxCell><mxCell id="c6" value="인증 / 그룹 동기화" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#464646;strokeWidth=1.5;fontFamily=Arial;fontSize=10;fontColor=#464646;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;할당 모델&lt;/b&gt;&amp;nbsp; IdP 그룹 → 권한세트 → 대상 계정 (Account Assignment)&lt;br&gt;&lt;span style='color:#7D7D7D'&gt;사용자 직접 할당 금지 · 그룹 단위 할당 · 권한세트 명명: PS-{범위}-{역할}&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#2D2D2D;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="670" y="110" width="590" height="64" as="geometry"/></mxCell><mxCell id="c8" value="① 공통 권한세트 — Cloud 인프라 영역 &amp;nbsp;&lt;span style='font-size:11px;font-weight:normal;color:#7D7D7D'&gt;(AI Eco · AI DevOps 전 계정 공통 할당)&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=0;fillColor=#F5F5F5;strokeColor=#DEDEDE;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#2D2D2D;" vertex="1" parent="1"><mxGeometry x="40" y="210" width="1220" height="170" as="geometry"/></mxCell><mxCell id="c9" value="권한세트 프로비저닝" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#464646;strokeWidth=1.5;fontFamily=Arial;fontSize=10;fontColor=#464646;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.23;entryY=0;" edge="1" parent="1" source="c5" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c10" value='&lt;div style="font-size:13px;font-weight:bold;color:#000000;"&gt;DB 관리자&lt;/div&gt;&lt;div style="font-size:10px;color:#D04A02;margin-top:3px;"&gt;PS-CMN-DBAdmin&lt;/div&gt;&lt;hr style="border:none;border-top:1px solid #EAEAEA;margin:6px 0;"&gt;&lt;div style="font-size:10.5px;color:#464646;line-height:1.45;"&gt;RDS / Aurora / DynamoDB&lt;br&gt;파라미터·백업·스냅샷 운영&lt;/div&gt;' style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=0;fillColor=#FFFFFF;strokeColor=#DEDEDE;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#2D2D2D;" vertex="1" parent="1"><mxGeometry x="54.0" y="254" width="188.66666666666666" height="112" as="geometry"/></mxCell><mxCell id="c11" value='&lt;div style="font-size:13px;font-weight:bold;color:#000000;"&gt;시스템 관리자&lt;/div&gt;&lt;div style="font-size:10px;color:#D04A02;margin-top:3px;"&gt;PS-CMN-SysAdmin&lt;/div&gt;&lt;hr style="border:none;border-top:1px solid #EAEAEA;margin:6px 0;"&gt;&lt;div style="font-size:10.5px;color:#464646;line-height:1.45;"&gt;EC2 / SSM / Auto Scaling&lt;br&gt;패치·OS 운영 (SSM 접속)&lt;/div&gt;' style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=0;fillColor=#FFFFFF;strokeColor=#DEDEDE;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#2D2D2D;" vertex="1" parent="1"><mxGeometry x="254.66666666666666" y="254" width="188.66666666666666" height="112" as="geometry"/></mxCell><mxCell id="c12" value='&lt;div style="font-size:13px;font-weight:bold;color:#000000;"&gt;네트워크 관리자&lt;/div&gt;&lt;div style="font-size:10px;color:#D04A02;margin-top:3px;"&gt;PS-CMN-NetAdmin&lt;/div&gt;&lt;hr style="border:none;border-top:1px solid #EAEAEA;margin:6px 0;"&gt;&lt;div style="font-size:10.5px;color:#464646;line-height:1.45;"&gt;VPC / TGW / Route 53&lt;br&gt;ELB · SG · NACL&lt;/div&gt;' style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=0;fillColor=#FFFFFF;strokeColor=#DEDEDE;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#2D2D2D;" vertex="1" parent="1"><mxGeometry x="455.3333333333333" y="254" width="188.66666666666666" height="112" as="geometry"/></mxCell><mxCell id="c13" value='&lt;div style="font-size:13px;font-weight:bold;color:#000000;"&gt;FinOps 조회자&lt;/div&gt;&lt;div style="font-size:10px;color:#D04A02;margin-top:3px;"&gt;PS-CMN-FinOpsRO&lt;/div&gt;&lt;hr style="border:none;border-top:1px solid #EAEAEA;margin:6px 0;"&gt;&lt;div style="font-size:10.5px;color:#464646;line-height:1.45;"&gt;Cost Explorer / CUR / Budgets&lt;br&gt;비용·사용량 Read-Only&lt;/div&gt;' style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=0;fillColor=#FFFFFF;strokeColor=#DEDEDE;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#2D2D2D;" vertex="1" parent="1"><mxGeometry x="656.0" y="254" width="188.66666666666666" height="112" as="geometry"/></mxCell><mxCell id="c14" value='&lt;div style="font-size:13px;font-weight:bold;color:#000000;"&gt;EKS 플랫폼 관리자&lt;/div&gt;&lt;div style="font-size:10px;color:#D04A02;margin-top:3px;"&gt;PS-CMN-EKSAdmin&lt;/div&gt;&lt;hr style="border:none;border-top:1px solid #EAEAEA;margin:6px 0;"&gt;&lt;div style="font-size:10.5px;color:#464646;line-height:1.45;"&gt;EKS 클러스터·노드그룹·Add-on&lt;br&gt;Access Entry ↔ K8s RBAC 연계&lt;/div&gt;' style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=0;fillColor=#FFFFFF;strokeColor=#DEDEDE;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#2D2D2D;" vertex="1" parent="1"><mxGeometry x="856.6666666666666" y="254" width="188.66666666666666" height="112" as="geometry"/></mxCell><mxCell id="c15" value='&lt;div style="font-size:13px;font-weight:bold;color:#000000;"&gt;인프라 관리자&lt;/div&gt;&lt;div style="font-size:10px;color:#D04A02;margin-top:3px;"&gt;PS-CMN-InfraAdmin&lt;/div&gt;&lt;hr style="border:none;border-top:1px solid #EAEAEA;margin:6px 0;"&gt;&lt;div style="font-size:10.5px;color:#464646;line-height:1.45;"&gt;MSK / ElastiCache 등&lt;br&gt;관리형 미들웨어 운영&lt;/div&gt;' style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=0;fillColor=#FFFFFF;strokeColor=#DEDEDE;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#2D2D2D;" vertex="1" parent="1"><mxGeometry x="1057.3333333333333" y="254" width="188.66666666666666" height="112" as="geometry"/></mxCell><mxCell id="c16" value="② AI Eco 계정 — 서비스 권한세트" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=0;fillColor=#FFFFFF;strokeColor=#7D7D7D;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="520" height="220" as="geometry"/></mxCell><mxCell id="c17" value="③ AI DevOps 계정 — 서비스 권한세트" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=0;fillColor=#FFFFFF;strokeColor=#7D7D7D;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="580" y="440" width="680" height="220" as="geometry"/></mxCell><mxCell id="c18" value="공통 할당" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#464646;strokeWidth=1.5;fontFamily=Arial;fontSize=10;fontColor=#464646;labelBackgroundColor=#FFFFFF;exitX=0.21;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c8" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="공통 할당" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#464646;strokeWidth=1.5;fontFamily=Arial;fontSize=10;fontColor=#464646;labelBackgroundColor=#FFFFFF;exitX=0.71;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c8" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value='&lt;div style="font-size:13px;font-weight:bold;color:#000000;"&gt;AI 서비스 플랫폼 관리자&lt;/div&gt;&lt;div style="font-size:10px;color:#D04A02;margin-top:3px;"&gt;PS-AIECO-AIPlatformAdmin&lt;/div&gt;&lt;hr style="border:none;border-top:1px solid #EAEAEA;margin:6px 0;"&gt;&lt;div style="font-size:10.5px;color:#464646;line-height:1.45;"&gt;AI 플랫폼 구성·설정&lt;br&gt;(Bedrock / SageMaker 등)&lt;br&gt;모델·엔드포인트 관리&lt;/div&gt;' style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=0;fillColor=#FFFFFF;strokeColor=#DEDEDE;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#2D2D2D;strokeColor=#D04A02;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="54.0" y="484" width="156.0" height="162" as="geometry"/></mxCell><mxCell id="c21" value='&lt;div style="font-size:13px;font-weight:bold;color:#000000;"&gt;AI 서비스 개발자&lt;/div&gt;&lt;div style="font-size:10px;color:#D04A02;margin-top:3px;"&gt;PS-AIECO-AIDeveloper&lt;/div&gt;&lt;hr style="border:none;border-top:1px solid #EAEAEA;margin:6px 0;"&gt;&lt;div style="font-size:10.5px;color:#464646;line-height:1.45;"&gt;AI 서비스 개발 리소스&lt;br&gt;Dev/Stg 환경 한정&lt;br&gt;Prod 변경 권한 없음&lt;/div&gt;' style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=0;fillColor=#FFFFFF;strokeColor=#DEDEDE;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#2D2D2D;" vertex="1" parent="1"><mxGeometry x="222.0" y="484" width="156.0" height="162" as="geometry"/></mxCell><mxCell id="c22" value='&lt;div style="font-size:13px;font-weight:bold;color:#000000;"&gt;애플리케이션 운영/관리자&lt;/div&gt;&lt;div style="font-size:10px;color:#D04A02;margin-top:3px;"&gt;PS-AIECO-AppOps&lt;/div&gt;&lt;hr style="border:none;border-top:1px solid #EAEAEA;margin:6px 0;"&gt;&lt;div style="font-size:10.5px;color:#464646;line-height:1.45;"&gt;배포 상태·로그·모니터링&lt;br&gt;애플리케이션 재기동&lt;br&gt;인프라 변경 권한 없음&lt;/div&gt;' style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=0;fillColor=#FFFFFF;strokeColor=#DEDEDE;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#2D2D2D;" vertex="1" parent="1"><mxGeometry x="390.0" y="484" width="156.0" height="162" as="geometry"/></mxCell><mxCell id="c23" value='&lt;div style="font-size:13px;font-weight:bold;color:#000000;"&gt;AI 서비스 플랫폼 관리자&lt;/div&gt;&lt;div style="font-size:10px;color:#D04A02;margin-top:3px;"&gt;PS-AIDEVOPS-AIPlatformAdmin&lt;/div&gt;&lt;hr style="border:none;border-top:1px solid #EAEAEA;margin:6px 0;"&gt;&lt;div style="font-size:10.5px;color:#464646;line-height:1.45;"&gt;AI DevOps 플랫폼 구성&lt;br&gt;파이프라인·모델 레지스트리&lt;/div&gt;' style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=0;fillColor=#FFFFFF;strokeColor=#DEDEDE;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#2D2D2D;strokeColor=#D04A02;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="594.0" y="484" width="154.0" height="162" as="geometry"/></mxCell><mxCell id="c24" value='&lt;div style="font-size:13px;font-weight:bold;color:#000000;"&gt;Rosetta 개발자&lt;/div&gt;&lt;div style="font-size:10px;color:#D04A02;margin-top:3px;"&gt;PS-AIDEVOPS-RosettaDev&lt;/div&gt;&lt;hr style="border:none;border-top:1px solid #EAEAEA;margin:6px 0;"&gt;&lt;div style="font-size:10.5px;color:#464646;line-height:1.45;"&gt;Rosetta 리소스 한정&lt;br&gt;ABAC: Project=rosetta&lt;/div&gt;' style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=0;fillColor=#FFFFFF;strokeColor=#DEDEDE;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#2D2D2D;" vertex="1" parent="1"><mxGeometry x="760.0" y="484" width="154.0" height="162" as="geometry"/></mxCell><mxCell id="c25" value='&lt;div style="font-size:13px;font-weight:bold;color:#000000;"&gt;ncstudio 개발자&lt;/div&gt;&lt;div style="font-size:10px;color:#D04A02;margin-top:3px;"&gt;PS-AIDEVOPS-NcstudioDev&lt;/div&gt;&lt;hr style="border:none;border-top:1px solid #EAEAEA;margin:6px 0;"&gt;&lt;div style="font-size:10.5px;color:#464646;line-height:1.45;"&gt;ncstudio 리소스 한정&lt;br&gt;ABAC: Project=ncstudio&lt;/div&gt;' style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=0;fillColor=#FFFFFF;strokeColor=#DEDEDE;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#2D2D2D;" vertex="1" parent="1"><mxGeometry x="926.0" y="484" width="154.0" height="162" as="geometry"/></mxCell><mxCell id="c26" value='&lt;div style="font-size:13px;font-weight:bold;color:#000000;"&gt;애플리케이션 운영/관리자&lt;/div&gt;&lt;div style="font-size:10px;color:#D04A02;margin-top:3px;"&gt;PS-AIDEVOPS-AppOps&lt;/div&gt;&lt;hr style="border:none;border-top:1px solid #EAEAEA;margin:6px 0;"&gt;&lt;div style="font-size:10.5px;color:#464646;line-height:1.45;"&gt;배포 상태·로그·모니터링&lt;br&gt;애플리케이션 재기동&lt;/div&gt;' style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=0;fillColor=#FFFFFF;strokeColor=#DEDEDE;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#2D2D2D;" vertex="1" parent="1"><mxGeometry x="1092.0" y="484" width="154.0" height="162" as="geometry"/></mxCell><mxCell id="c27" value="&lt;div style='font-size:14px;font-weight:bold;color:#000000;margin-bottom:8px;'&gt;Zero Trust Control Points&lt;/div&gt;&lt;div style='font-size:11px;color:#2D2D2D;line-height:1.5;'&gt;&lt;b&gt;1. SCP (Org Guardrail)&lt;/b&gt;&lt;br&gt;&lt;span style='color:#464646'&gt;리전 제한, CloudTrail·GuardDuty 비활성화 차단, Root 사용 차단&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;2. Permissions Boundary&lt;/b&gt;&lt;br&gt;&lt;span style='color:#464646'&gt;권한세트 내 IAM Role 생성 시 상한선 강제&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;3. ABAC (Tag 기반)&lt;/b&gt;&lt;br&gt;&lt;span style='color:#464646'&gt;Project · Env 태그 ↔ 세션 태그 일치 시만 허용&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;4. 세션 / JIT 통제&lt;/b&gt;&lt;br&gt;&lt;span style='color:#464646'&gt;관리자 PS 세션 1h, 고권한은 승인 기반 임시 할당 (JIT)&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;5. 감사 · 지속 검증&lt;/b&gt;&lt;br&gt;&lt;span style='color:#464646'&gt;CloudTrail 중앙 수집, IAM Access Analyzer 미사용 권한 정리 (분기)&lt;/span&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=0;fillColor=#F5F5F5;strokeColor=#DEDEDE;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="1290" y="110" width="270" height="550" as="geometry"/></mxCell><mxCell id="c28" value="&lt;span style='color:#D04A02'&gt;■&lt;/span&gt; 주황 테두리: 양 계정에 동일 역할 존재 → 단일 권한세트로 통합 후 계정별 할당 검토 대상 &amp;nbsp;&amp;nbsp;│&amp;nbsp;&amp;nbsp; 권한세트 명/범위는 설계(안)이며 상세 정책은 LLD에서 확정" style="html=1;whiteSpace=wrap;fontFamily=Arial;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#7D7D7D;" vertex="1" parent="1"><mxGeometry x="40" y="670" width="1220" height="22" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;So What:&lt;/b&gt; 인프라 권한(공통)과 서비스 권한(계정별)을 분리하고 SCP·Permissions Boundary·ABAC로 상한을 고정하면, 신규 계정·서비스 추가 시에도 권한세트 재설계 없이 할당만으로 최소권한을 유지할 수 있다." style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=0;fillColor=#F5F5F5;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=18;fontSize=12;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="702" width="1520" height="52" as="geometry"/></mxCell><mxCell id="c30" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=0;fillColor=#D04A02;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="702" width="5" height="52" as="geometry"/></mxCell><mxCell id="c31" value="Source: 차세대 BSS 아키텍처 보안 설계(안), AWS IAM Identity Center 권한세트 설계 기준 | Confidential" style="html=1;whiteSpace=wrap;fontFamily=Arial;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=9;fontColor=#7D7D7D;" vertex="1" parent="1"><mxGeometry x="40" y="762" width="1520" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>